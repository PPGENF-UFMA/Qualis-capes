# Elsevier API - Serial Title API (CiteScore)
# Obtenha sua chave em: https://dev.elsevier.com/apikey/manage
ELSEVIER_API_KEY=sua_chave_aqui

# Ambiente: "production" desabilita /docs e /redoc (Swagger)
# Deixe vazio ou "development" para manter a documentação ativa
ENVIRONMENT=development

# Proxies confiáveis para rate limiting (IPs separados por vírgula)
# Se o servidor estiver atrás de nginx/traefik/etc, liste o IP do proxy.
# Ex: 10.0.0.1,127.0.0.1
TRUSTED_PROXIES=
