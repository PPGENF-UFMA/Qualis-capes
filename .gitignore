# Variáveis de ambiente (contém API keys)
.env

# Caches gerados
data/*_cache.json

# Descobertas de runtime (gerado pelo servidor)
data/runtime_discoveries.json

# Node
node_modules/

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# PID file do servidor (gerado pelo server.ps1)
.server_pid

